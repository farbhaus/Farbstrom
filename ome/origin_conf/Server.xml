<?xml version="1.0" encoding="UTF-8"?>

<Server version="8">
    <Name>Farbstrom</Name>
    <Type>origin</Type>
    <IP>*</IP>
    <PrivacyProtection>false</PrivacyProtection>
    <StunServer>stun.ovenmediaengine.com:13478</StunServer>

    <Modules>
        <HTTP2>
            <Enable>true</Enable>
        </HTTP2>
        <LLHLS>
            <Enable>true</Enable>
        </LLHLS>
        <P2P>
            <Enable>false</Enable>
        </P2P>
        <ERTMP>
            <Enable>true</Enable>
        </ERTMP>
    </Modules>

    <Bind>
        <Managers>
            <API>
                <Port>8081</Port>
                <WorkerCount>1</WorkerCount>
            </API>
        </Managers>

        <Providers>
            <RTMP>
                <Port>1935</Port>
                <WorkerCount>1</WorkerCount>
            </RTMP>
            <SRT>
                <Port>9999</Port>
                <WorkerCount>1</WorkerCount>
                <!--
                    SRT ingest encryption (opt-in). Empty passphrase = no
                    encryption (backward compatible). Set SRT_INGEST_PASSPHRASE
                    (10-79 chars) in the env to require an encrypted push; the
                    encoder must send the same passphrase + pbkeylen.
                -->
                <Options>
                    <Option>
                        <Key>SRTO_PBKEYLEN</Key>
                        <Value>${env:SRT_PBKEYLEN:16}</Value>
                    </Option>
                    <Option>
                        <Key>SRTO_PASSPHRASE</Key>
                        <Value>${env:SRT_INGEST_PASSPHRASE:}</Value>
                    </Option>
                </Options>
            </SRT>
            <WebRTC>
                <Signalling>
                    <Port>3333</Port>
                    <TLSPort>3334</TLSPort>
                    <WorkerCount>1</WorkerCount>
                </Signalling>
                <IceCandidates>
                    <!--
                        INGEST side (WHIP / WebRTC push). Relay must NOT be forced
                        here. (Playback no longer forces it either — see the
                        Publishers block, further down.)

                        With TcpRelayForce=true, OME withholds its real candidates
                        and advertises the working path only through its embedded
                        TURN server, carried solely in "Link: rel=ice-server"
                        response headers. The SDP answer then contains a single
                        placeholder candidate (100.127.255.254 on a port nothing
                        listens on). OBS parses those Link headers and attempts
                        direct ICE anyway — obsproject/obs-studio#12790 — so every
                        WHIP push died the same way: HTTP 201 and a resource URL,
                        then "PeerConnection state is now: Connecting" → "Failed"
                        about 40 s later, with no media ever sent.

                        TcpRelay stays configured, so clients that do honour the
                        Link headers keep a relay fallback. TcpRelayForce is
                        v0.21.0's rename of the deprecated TcpForce.

                        OME_ICE_ADDRESS is derived in entrypoint.sh: "*" (enumerate
                        interfaces + the STUN-discovered public IP) on a real host,
                        127.0.0.1 on a localhost dev stack, where the enumerated
                        172.x/public addresses are not reachable from the host.
                    -->
                    <IceCandidate>${env:OME_ICE_ADDRESS:*}:10000-10009/udp</IceCandidate>
                    <TcpRelay>*:3478</TcpRelay>
                    <TcpRelayForce>false</TcpRelayForce>
                    <TcpRelayWorkerCount>1</TcpRelayWorkerCount>
                </IceCandidates>
            </WebRTC>
        </Providers>

        <Publishers>
            <LLHLS>
                <!-- Port 3333: OME multiplexes LLHLS (HTTP) and WebRTC signaling (WebSocket) on the same port -->
                <!-- Caddy proxies /live/* → localhost:3333 to handle both protocols -->
                <Port>3333</Port>
                <TLSPort>3334</TLSPort>
                <WorkerCount>2</WorkerCount>
            </LLHLS>
            <WebRTC>
                <Signalling>
                    <Port>3333</Port>
                    <TLSPort>3334</TLSPort>
                    <WorkerCount>2</WorkerCount>
                </Signalling>
                <IceCandidates>
                    <!--
                        PLAYBACK side: direct UDP and the TCP relay raced per
                        session, the relay alone as the fallback, chosen by the
                        viewer.

                        The viewer (frontend/viewer/player.ts) asks for
                        ?transport=all, and remounts with ?transport=relay if
                        nothing plays within 6 s. OME reads the parameter per
                        session (webrtc_publisher.cpp): all offers the UDP
                        candidates below plus the embedded TURN server on 3478,
                        and the browser takes UDP when it gets through; relay
                        offers only the TURN server. DefaultTransport applies to a
                        session that doesn't ask (an old cached viewer) and keeps
                        it on the relay, which is what every session got while the
                        relay was forced. TcpRelayForce must stay false: true
                        overrides ?transport for every session.

                        Why not force the relay any more: it put every viewer
                        behind their own TCP stack. Measured 2026-11-12, a MacBook
                        collapsed the receive window of its relay connection to
                        14 KB for 1-2.5 s every 30 s, in Chrome and Safari alike,
                        while UDP to the same machine was unaffected. Firefox, the
                        reason it was forced, plays fine over direct UDP on a real
                        host; the "Firefox never nominates" failure was measured on
                        a localhost Docker Desktop stack.

                        transport=all has to be in the URL: OvenPlayer sets
                        iceTransportPolicy "relay" whenever OME offers a relay
                        server and the URL doesn't say all, so DefaultTransport=all
                        on its own means relay-only. Measured 2026-11-13 with all in
                        the URL: Chrome and Firefox on UDP in 0.2-0.4 s, and with
                        their UDP dropped, on the relay in 0.3-0.55 s.

                        OME sends media down the pair the browser nominates first
                        and ignores later nominations. That is why the viewer keeps
                        its 6 s fallback: Safari with iCloud Private Relay reaches
                        the UDP candidates through Apple's relay, connects and
                        completes DTLS, and gets no picture when that pair wins.

                        The UDP candidate address follows the ingest provider's
                        (OME_ICE_ADDRESS, entrypoint.sh): "*" on a real host,
                        127.0.0.1 on a localhost stack.
                    -->
                    <IceCandidate>${env:OME_ICE_ADDRESS:*}:10000-10009/udp</IceCandidate>
                    <TcpRelay>*:3478</TcpRelay>
                    <TcpRelayForce>false</TcpRelayForce>
                    <DefaultTransport>relay</DefaultTransport>
                    <TcpRelayWorkerCount>2</TcpRelayWorkerCount>
                </IceCandidates>
            </WebRTC>
            <SRT>
                <Port>9998</Port>
                <WorkerCount>2</WorkerCount>
                <!--
                    SRT playback encryption (opt-in). Empty passphrase = no
                    encryption (backward compatible). Set SRT_PLAYBACK_PASSPHRASE
                    (10-79 chars) in the env to encrypt playback; Farbplay reads
                    the passphrase + pbkeylen from GET /api/watch/<slug> and
                    applies them to its SRT socket.
                -->
                <Options>
                    <Option>
                        <Key>SRTO_PBKEYLEN</Key>
                        <Value>${env:SRT_PBKEYLEN:16}</Value>
                    </Option>
                    <Option>
                        <Key>SRTO_PASSPHRASE</Key>
                        <Value>${env:SRT_PLAYBACK_PASSPHRASE:}</Value>
                    </Option>
                </Options>
            </SRT>
        </Publishers>
    </Bind>

    <Managers>
        <Host>
            <Names>
                <Name>*</Name>
            </Names>
        </Host>
        <API>
            <AccessToken>${env:OME_API_TOKEN:default}</AccessToken>
            <CrossDomains>
                <Url>*</Url>
            </CrossDomains>
        </API>
    </Managers>

    <Defaults>
        <CrossDomains>
            <Url>*</Url>
        </CrossDomains>
    </Defaults>

    <VirtualHosts>
        <VirtualHost>
            <Name>default</Name>
            <Distribution>${env:OME_HOST_IP:localhost}</Distribution>

            <Host>
                <Names>
                    <Name>*</Name>
                </Names>
            </Host>

            <!--
                Admission Webhook — OME asks the backend before every ingest
                (stream key check; the reply renames the stream to the key's
                playback id via new_url) and before every browser playback
                session (participant or admin-preview credentials in the query
                string). Backend responds with accept/deny JSON. See
                backend/src/routes/webhook.rs and backend/src/playback.rs.
            -->
            <AdmissionWebhooks>
                <!-- Single-container: the backend runs on localhost, not a
                     Docker service name. Overridable for multi-container with
                     OME_WEBHOOK_URL=http://stream-backend:4001/api/webhook/admission -->
                <ControlServerUrl>${env:OME_WEBHOOK_URL:http://localhost:4001/api/webhook/admission}</ControlServerUrl>
                <SecretKey>${env:OME_WEBHOOK_SECRET:default}</SecretKey>
                <Timeout>5000</Timeout>
                <Enables>
                    <!-- Validate all ingest connections (stream key auth) -->
                    <Providers>rtmp,srt,webrtc</Providers>
                    <!-- Validate browser playback. SRT playback is gated by
                         SignedPolicy below instead. -->
                    <Publishers>webrtc,llhls</Publishers>
                </Enables>
            </AdmissionWebhooks>

            <!--
                SignedPolicy — gates SRT *playback* (port 9998) for the Farbplay
                room-link flow (GitHub #165). The backend's /api/watch/<slug>
                endpoint mints a short-lived, HMAC-SHA1-signed streamid; OME
                validates the signature + url_expire here and rejects expired or
                forged tokens.

                Scoped to <Publishers>srt only: browser playback (LLHLS/WebRTC)
                and all ingest are gated by the admission webhook above instead.
                SecretKey must match OME_SIGNED_POLICY_SECRET in the backend env.
            -->
            <SignedPolicy>
                <PolicyQueryKeyName>policy</PolicyQueryKeyName>
                <SignatureQueryKeyName>signature</SignatureQueryKeyName>
                <SecretKey>${env:OME_SIGNED_POLICY_SECRET:default}</SecretKey>
                <Enables>
                    <Providers></Providers>
                    <Publishers>srt</Publishers>
                </Enables>
            </SignedPolicy>

            <Applications>
                <Application>
                    <Name>live</Name>
                    <Type>live</Type>

                    <OutputProfiles>
                        <!--
                            No <HWAccels> block: OME deprecated hardware acceleration in
                            v0.21.0 (Intel QSV removed outright) and warns-and-disables it
                            when enabled. Farbstrom bypasses video anyway, so there is
                            nothing to accelerate.
                        -->
                        <OutputProfile>
                            <Name>bypass</Name>
                            <OutputStreamName>${OriginStreamName}</OutputStreamName>

                            <!--
                                H.264 fallback for browsers that cannot decode the main
                                (HEVC 10-bit) picture. An encoder that sends BOTH an HEVC and
                                an H.264 video PID in one SRT stream (Farbcode's fallback
                                output: HEVC on 0x101, AAC on 0x102, H.264 on 0x103) gets two
                                tracks in the bypass_video group, numbered in PID order - the
                                lower PID is index 0. So the H.264 PID must be the higher one.

                                Every default playlist starts from index 0 - llhls.m3u8, the
                                bare WebRTC URL and SRT's own - so the main picture and any
                                single-track stream are served exactly as before. This
                                playlist exposes index 1:
                                  LL-HLS  /live/<pid>/fallback.m3u8
                                  WebRTC  /live/<pid>/fallback
                                The admission webhook gates both like any other playback
                                URL: the stream is the path segment after the app.

                                Two renditions because a rendition names one audio track:
                                LL-HLS keeps the AAC one and drops the Opus one (unsupported
                                codec there), and WebRTC's offer skips the AAC payload and
                                negotiates Opus.

                                The H.264 cannot share a playlist with the HEVC. WebRTC
                                serves the codec the browser's answer lists first
                                (rtc_session.cpp), OME offers H.264 before H.265 (a map keyed
                                by codec id), and browsers answer in the offer's order - so a
                                mixed playlist hands an HEVC-capable Chrome the H.264. The
                                viewer picks the playlist instead (frontend/viewer/player.ts).

                                SRT ignores this playlist (no EnableTsPackaging), but its
                                default playlist muxes EVERY track of the bypass_video group
                                (srt_stream.cpp ignores VideoIndexHint): Farbplay receives
                                both video PIDs and must lock to the HEVC one. And use
                                explicit renditions - RenditionTemplate's VideoIndexHint is
                                never parsed in v0.21.0 (video_template.h).

                                A single-track stream leaves this playlist without video:
                                the LL-HLS one is empty and the WebRTC one would answer with
                                audio only, which is why the viewer asks for it only after
                                the LL-HLS probe has found a video track in it.
                            -->
                            <Playlist>
                                <Name>fallback</Name>
                                <FileName>fallback</FileName>
                                <Options>
                                    <WebRtcAutoAbr>false</WebRtcAutoAbr>
                                </Options>
                                <Rendition>
                                    <Name>h264_aac</Name>
                                    <Video>bypass_video</Video>
                                    <VideoIndexHint>1</VideoIndexHint>
                                    <Audio>aac_audio</Audio>
                                </Rendition>
                                <Rendition>
                                    <Name>h264_opus</Name>
                                    <Video>bypass_video</Video>
                                    <VideoIndexHint>1</VideoIndexHint>
                                    <Audio>opus_audio</Audio>
                                </Rendition>
                            </Playlist>

                            <Encodes>
                                <!--
                                    Video bypass — passes H.264 or H.265 as-is for WebRTC.
                                    No GPU required.
                                -->
                                <Video>
                                    <Name>bypass_video</Name>
                                    <Bypass>true</Bypass>
                                </Video>


                                <!--
                                    LLHLS / SRT path. AAC from OBS at 48 kHz stereo is passed
                                    through untouched (Passthrough:0 in transcoder logs). The
                                    Bitrate / Samplerate / Channel below are only used if the
                                    source ever fails the BypassIfMatch (e.g. a different codec
                                    or higher samplerate).
                                -->
                                <Audio>
                                    <Name>aac_audio</Name>
                                    <Codec>aac</Codec>
                                    <Bitrate>320000</Bitrate>
                                    <Samplerate>48000</Samplerate>
                                    <Channel>2</Channel>
                                    <BypassIfMatch>
                                        <Codec>eq</Codec>
                                        <Samplerate>lte</Samplerate>
                                        <Channel>eq</Channel>
                                    </BypassIfMatch>
                                </Audio>

                                <!--
                                    WebRTC path. Per OME docs, WebRTC does not support AAC, so
                                    this encode is mandatory whenever the source is AAC — there
                                    is no bypass option. BypassIfMatch only kicks in if the
                                    source ever arrives as Opus already (uncommon from
                                    OBS/SRT/RTMP).
                                -->
                                <Audio>
                                    <Name>opus_audio</Name>
                                    <Codec>opus</Codec>
                                    <Bitrate>320000</Bitrate>
                                    <Samplerate>48000</Samplerate>
                                    <Channel>2</Channel>
                                    <BypassIfMatch>
                                        <Codec>eq</Codec>
                                        <Samplerate>lte</Samplerate>
                                        <Channel>eq</Channel>
                                    </BypassIfMatch>
                                </Audio>
                            </Encodes>
                        </OutputProfile>
                    </OutputProfiles>

                    <Providers>
                        <RTMP />
                        <SRT />
                        <WebRTC>
                            <Timeout>30000</Timeout>
                            <CrossDomains>
                                <Url>*</Url>
                            </CrossDomains>
                        </WebRTC>
                    </Providers>

                    <Publishers>
                        <AppWorkerCount>1</AppWorkerCount>
                        <StreamWorkerCount>2</StreamWorkerCount>

                        <WebRTC>
                            <Timeout>30000</Timeout>
                            <Rtx>true</Rtx>
                            <Ulpfec>true</Ulpfec>
                            <JitterBuffer>false</JitterBuffer>
                        </WebRTC>

                        <LLHLS>
                            <ChunkDuration>0.2</ChunkDuration>
                            <PartHoldBack>0.6</PartHoldBack>
                            <!--
                                Startup latency, not live latency. OME does not publish
                                the master playlist until the first segment completes, so
                                this value is the floor on how soon a viewer can start:
                                measured 5.82s at 6, 1.69s at 1 (cold start).
                                ChunkDuration/PartHoldBack still govern live latency.

                                1 means "one GOP per segment" — segments can never be
                                shorter than the encoder's keyframe interval, so a 2s GOP
                                yields 2s segments whatever this says. If startup feels
                                slow, the encoder's keyframe interval is the real lever.

                                Rewind window is SegmentCount x segment length (~20s at a
                                2s GOP). Nothing here exposes seeking on a live stream.
                            -->
                            <SegmentDuration>1</SegmentDuration>
                            <SegmentCount>10</SegmentCount>
                            <DVR>
                                <Enable>false</Enable>
                            </DVR>
                            <CrossDomains>
                                <Url>*</Url>
                            </CrossDomains>
                            <CreateDefaultPlaylist>true</CreateDefaultPlaylist>
                        </LLHLS>

                        <SRT />
                    </Publishers>
                </Application>
            </Applications>
        </VirtualHost>
    </VirtualHosts>
</Server>
