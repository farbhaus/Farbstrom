<?xml version="1.0" encoding="UTF-8"?>

<Server version="8">
    <Name>Farbstrom</Name>
    <Type>origin</Type>
    <IP>*</IP>
    <PrivacyProtection>false</PrivacyProtection>
    <StunServer>stun.ovenmediaengine.com:13478</StunServer>

    <Modules>
        <HTTP2>
            <Enable>true</Enable>
        </HTTP2>
        <LLHLS>
            <Enable>true</Enable>
        </LLHLS>
        <P2P>
            <Enable>false</Enable>
        </P2P>
        <ERTMP>
            <Enable>true</Enable>
        </ERTMP>
    </Modules>

    <Bind>
        <Managers>
            <API>
                <Port>8081</Port>
                <WorkerCount>1</WorkerCount>
            </API>
        </Managers>

        <Providers>
            <RTMP>
                <Port>1935</Port>
                <WorkerCount>1</WorkerCount>
            </RTMP>
            <SRT>
                <Port>9999</Port>
                <WorkerCount>1</WorkerCount>
                <!--
                    SRT ingest encryption (opt-in). Empty passphrase = no
                    encryption (backward compatible). Set SRT_INGEST_PASSPHRASE
                    (10-79 chars) in the env to require an encrypted push; the
                    encoder must send the same passphrase + pbkeylen.
                -->
                <Options>
                    <Option>
                        <Key>SRTO_PBKEYLEN</Key>
                        <Value>${env:SRT_PBKEYLEN:16}</Value>
                    </Option>
                    <Option>
                        <Key>SRTO_PASSPHRASE</Key>
                        <Value>${env:SRT_INGEST_PASSPHRASE:}</Value>
                    </Option>
                </Options>
            </SRT>
            <WebRTC>
                <Signalling>
                    <Port>3333</Port>
                    <TLSPort>3334</TLSPort>
                    <WorkerCount>1</WorkerCount>
                </Signalling>
                <IceCandidates>
                    <!--
                        Relay-forced on purpose. Direct ICE was tried on OME v0.21.0
                        (${PublicIP} candidates + RFC 6544 TCP ICE, TcpRelayForce=false)
                        and broke Firefox: it never nominated a candidate and looped
                        "Added session"/"Removed session" forever. Offering the relay
                        alongside direct candidates did not fix it either, because with
                        the container behind Docker NAT the relay is only advertised at
                        ${PublicIP} and 172.x — neither reachable as localhost. Forcing
                        the relay is the configuration that works in every browser.
                        TcpRelayForce is v0.21.0's rename of the deprecated TcpForce.
                    -->
                    <IceCandidate>*:10000-10009/udp</IceCandidate>
                    <TcpRelay>*:3478</TcpRelay>
                    <TcpRelayForce>true</TcpRelayForce>
                    <TcpRelayWorkerCount>1</TcpRelayWorkerCount>
                </IceCandidates>
            </WebRTC>
        </Providers>

        <Publishers>
            <LLHLS>
                <!-- Port 3333: OME multiplexes LLHLS (HTTP) and WebRTC signaling (WebSocket) on the same port -->
                <!-- Caddy proxies /live/* → localhost:3333 to handle both protocols -->
                <Port>3333</Port>
                <TLSPort>3334</TLSPort>
                <WorkerCount>2</WorkerCount>
            </LLHLS>
            <WebRTC>
                <Signalling>
                    <Port>3333</Port>
                    <TLSPort>3334</TLSPort>
                    <WorkerCount>2</WorkerCount>
                </Signalling>
                <IceCandidates>
                    <!-- Same transport policy as the WebRTC provider above — see there
                         for why the relay is forced rather than direct ICE. -->
                    <IceCandidate>*:10000-10009/udp</IceCandidate>
                    <TcpRelay>*:3478</TcpRelay>
                    <TcpRelayForce>true</TcpRelayForce>
                    <TcpRelayWorkerCount>2</TcpRelayWorkerCount>
                </IceCandidates>
            </WebRTC>
            <SRT>
                <Port>9998</Port>
                <WorkerCount>2</WorkerCount>
                <!--
                    SRT playback encryption (opt-in). Empty passphrase = no
                    encryption (backward compatible). Set SRT_PLAYBACK_PASSPHRASE
                    (10-79 chars) in the env to encrypt playback; Farbplay reads
                    the passphrase + pbkeylen from GET /api/watch/<slug> and
                    applies them to its SRT socket.
                -->
                <Options>
                    <Option>
                        <Key>SRTO_PBKEYLEN</Key>
                        <Value>${env:SRT_PBKEYLEN:16}</Value>
                    </Option>
                    <Option>
                        <Key>SRTO_PASSPHRASE</Key>
                        <Value>${env:SRT_PLAYBACK_PASSPHRASE:}</Value>
                    </Option>
                </Options>
            </SRT>
        </Publishers>
    </Bind>

    <Managers>
        <Host>
            <Names>
                <Name>*</Name>
            </Names>
        </Host>
        <API>
            <AccessToken>${env:OME_API_TOKEN:default}</AccessToken>
            <CrossDomains>
                <Url>*</Url>
            </CrossDomains>
        </API>
    </Managers>

    <Defaults>
        <CrossDomains>
            <Url>*</Url>
        </CrossDomains>
    </Defaults>

    <VirtualHosts>
        <VirtualHost>
            <Name>default</Name>
            <Distribution>${env:OME_HOST_IP:localhost}</Distribution>

            <Host>
                <Names>
                    <Name>*</Name>
                </Names>
            </Host>

            <!--
                Admission Webhook — OME calls our backend to validate every
                ingest connection (stream key check) and optionally viewer connections.
                Backend responds with accept/deny JSON.
            -->
            <AdmissionWebhooks>
                <!-- Single-container: the backend runs on localhost, not a
                     Docker service name. Overridable for multi-container with
                     OME_WEBHOOK_URL=http://stream-backend:4001/api/webhook/admission -->
                <ControlServerUrl>${env:OME_WEBHOOK_URL:http://localhost:4001/api/webhook/admission}</ControlServerUrl>
                <SecretKey>${env:OME_WEBHOOK_SECRET:default}</SecretKey>
                <Timeout>5000</Timeout>
                <Enables>
                    <!-- Validate all ingest connections (stream key auth) -->
                    <Providers>rtmp,srt,webrtc</Providers>
                    <!-- Phase 2: enable webrtc,llhls here for viewer waiting room -->
                    <Publishers></Publishers>
                </Enables>
            </AdmissionWebhooks>

            <!--
                SignedPolicy — gates SRT *playback* (port 9998) for the Farbplay
                room-link flow (GitHub #165). The backend's /api/watch/<slug>
                endpoint mints a short-lived, HMAC-SHA1-signed streamid; OME
                validates the signature + url_expire here and rejects expired or
                forged tokens.

                Scoped to <Publishers>srt only: browser playback (LLHLS/WebRTC)
                and all ingest (Providers, gated by the admission webhook above)
                are unaffected. SecretKey must match OME_SIGNED_POLICY_SECRET in
                the backend env.
            -->
            <SignedPolicy>
                <PolicyQueryKeyName>policy</PolicyQueryKeyName>
                <SignatureQueryKeyName>signature</SignatureQueryKeyName>
                <SecretKey>${env:OME_SIGNED_POLICY_SECRET:default}</SecretKey>
                <Enables>
                    <Providers></Providers>
                    <Publishers>srt</Publishers>
                </Enables>
            </SignedPolicy>

            <Applications>
                <Application>
                    <Name>live</Name>
                    <Type>live</Type>

                    <OutputProfiles>
                        <!--
                            No <HWAccels> block: OME deprecated hardware acceleration in
                            v0.21.0 (Intel QSV removed outright) and warns-and-disables it
                            when enabled. Farbstrom bypasses video anyway, so there is
                            nothing to accelerate.
                        -->
                        <OutputProfile>
                            <Name>bypass</Name>
                            <OutputStreamName>${OriginStreamName}</OutputStreamName>

                            <Encodes>
                                <!--
                                    Video bypass — passes H.264 or H.265 as-is for WebRTC.
                                    No GPU required.
                                -->
                                <Video>
                                    <Name>bypass_video</Name>
                                    <Bypass>true</Bypass>
                                </Video>


                                <!--
                                    LLHLS / SRT path. AAC from OBS at 48 kHz stereo is passed
                                    through untouched (Passthrough:0 in transcoder logs). The
                                    Bitrate / Samplerate / Channel below are only used if the
                                    source ever fails the BypassIfMatch (e.g. a different codec
                                    or higher samplerate).
                                -->
                                <Audio>
                                    <Name>aac_audio</Name>
                                    <Codec>aac</Codec>
                                    <Bitrate>320000</Bitrate>
                                    <Samplerate>48000</Samplerate>
                                    <Channel>2</Channel>
                                    <BypassIfMatch>
                                        <Codec>eq</Codec>
                                        <Samplerate>lte</Samplerate>
                                        <Channel>eq</Channel>
                                    </BypassIfMatch>
                                </Audio>

                                <!--
                                    WebRTC path. Per OME docs, WebRTC does not support AAC, so
                                    this encode is mandatory whenever the source is AAC — there
                                    is no bypass option. BypassIfMatch only kicks in if the
                                    source ever arrives as Opus already (uncommon from
                                    OBS/SRT/RTMP).
                                -->
                                <Audio>
                                    <Name>opus_audio</Name>
                                    <Codec>opus</Codec>
                                    <Bitrate>320000</Bitrate>
                                    <Samplerate>48000</Samplerate>
                                    <Channel>2</Channel>
                                    <BypassIfMatch>
                                        <Codec>eq</Codec>
                                        <Samplerate>lte</Samplerate>
                                        <Channel>eq</Channel>
                                    </BypassIfMatch>
                                </Audio>
                            </Encodes>
                        </OutputProfile>
                    </OutputProfiles>

                    <Providers>
                        <RTMP />
                        <SRT />
                        <WebRTC>
                            <Timeout>30000</Timeout>
                            <CrossDomains>
                                <Url>*</Url>
                            </CrossDomains>
                        </WebRTC>
                    </Providers>

                    <Publishers>
                        <AppWorkerCount>1</AppWorkerCount>
                        <StreamWorkerCount>2</StreamWorkerCount>

                        <WebRTC>
                            <Timeout>30000</Timeout>
                            <Rtx>true</Rtx>
                            <Ulpfec>true</Ulpfec>
                            <JitterBuffer>false</JitterBuffer>
                        </WebRTC>

                        <LLHLS>
                            <ChunkDuration>0.2</ChunkDuration>
                            <PartHoldBack>0.6</PartHoldBack>
                            <SegmentDuration>6</SegmentDuration>
                            <SegmentCount>10</SegmentCount>
                            <DVR>
                                <Enable>false</Enable>
                            </DVR>
                            <CrossDomains>
                                <Url>*</Url>
                            </CrossDomains>
                            <CreateDefaultPlaylist>true</CreateDefaultPlaylist>
                        </LLHLS>

                        <SRT />
                    </Publishers>
                </Application>
            </Applications>
        </VirtualHost>
    </VirtualHosts>
</Server>
